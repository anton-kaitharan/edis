{
  "version": 1,
  "author": "Smart Grain Storage Monitor",
  "editor": "wokwi",
  "parts": [
    { "type": "board-esp32-devkit-c-v4", "id": "esp", "top": 0, "left": 0, "attrs": {} },
    { "type": "wokwi-dht22", "id": "dht", "top": -100, "left": 250, "attrs": { "temperature": "24", "humidity": "52" } },
    { "type": "wokwi-led", "id": "led", "top": -10, "left": 260, "attrs": { "color": "green" } },
    { "type": "wokwi-resistor", "id": "r1", "top": 30, "left": 330, "attrs": { "value": "220" } },
    { "type": "wokwi-buzzer", "id": "bz", "top": 90, "left": 280, "attrs": {} },
    { "type": "wokwi-pushbutton", "id": "btn", "top": 160, "left": 280, "attrs": { "color": "green", "xray": "1" } }
  ],
  "connections": [
    [ "esp:TX0", "$serialMonitor:RX", "", [] ], [ "esp:RX0", "$serialMonitor:TX", "", [] ],
    [ "esp:D4", "dht:SDA", "green", [] ], [ "esp:3V3", "dht:VCC", "red", [] ], [ "esp:GND.1", "dht:GND", "black", [] ],
    [ "esp:D2", "led:A", "green", [] ], [ "led:C", "r1:1", "green", [] ], [ "r1:2", "esp:GND.1", "black", [] ],
    [ "esp:D5", "bz:2", "green", [] ], [ "bz:1", "esp:GND.1", "black", [] ],
    [ "esp:D15", "btn:1.l", "green", [] ], [ "btn:2.l", "esp:GND.1", "black", [] ]
  ],
  "dependencies": {}
}
